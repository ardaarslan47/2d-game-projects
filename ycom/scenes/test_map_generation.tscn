[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/map_generator.gd" id="1_mapgen"]
[ext_resource type="Script" path="res://scripts/test_map_scene.gd" id="2_test"]

[node name="TestMapGeneration" type="Node2D"]
script = ExtResource("2_test")

[node name="TileMap" type="TileMap" parent="."]
format = 2
layer_0/name = "Terrain"
layer_0/tile_data = PackedInt32Array()

[node name="ObstacleContainer" type="Node2D" parent="."]

[node name="MapGenerator" type="Node" parent="."]
script = ExtResource("1_mapgen")
map_width = 20
map_height = 15
obstacle_density = 0.15
elevated_terrain_chance = 0.3

[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(320, 240)

[node name="UI" type="CanvasLayer" parent="."]

[node name="Control" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="UI/Control"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = -100.0
offset_right = 200.0
offset_bottom = -10.0
grow_vertical = 0

[node name="GenerateButton" type="Button" parent="UI/Control/VBoxContainer"]
layout_mode = 2
text = "Generate New Map"

[node name="SeedLabel" type="Label" parent="UI/Control/VBoxContainer"]
layout_mode = 2
text = "Seed: 0"

[node name="InfoLabel" type="Label" parent="UI/Control/VBoxContainer"]
layout_mode = 2
text = "Press button to generate"

[connection signal="pressed" from="UI/Control/VBoxContainer/GenerateButton" to="." method="_on_generate_button_pressed"]
